generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model app_user {
  id            String         @id
  email         String?        @unique
  username      String?
  points        Int            @default(0)
  created_at    DateTime       @default(now()) @db.Timestamptz(6)
  updated_at    DateTime       @default(now()) @db.Timestamptz(6)
  claims        claim[]        @relation("claim_user")
  listings      listing[]      @relation("listing_finder")
  notifications notification[] @relation("notification_user")
  user_pref     user_pref?     @relation("user_pref_by_user")
}

model category {
  id       Int       @id @db.SmallInt
  name     String    @unique
  listings listing[]
}

model user_pref {
  user_id          String   @id
  notifications_on Boolean  @default(true)
  radius_meters    Int      @default(1000)
  category_filter  String[] @default([])
  dark_mode        Boolean  @default(true)
  updated_at       DateTime @default(now()) @db.Timestamptz(6)
  user             app_user @relation("user_pref_by_user", fields: [user_id], references: [id], onDelete: Cascade)
}

model listing {
  id             String          @id
  finder_user_id String
  title          String
  description    String?
  category_id    Int?            @db.SmallInt
  status         String          @default("active")
  found_at       DateTime        @default(now()) @db.Timestamptz(6)
  expires_at     DateTime        @db.Timestamptz(6)
  lat            Float
  lng            Float
  place_name     String?
  manual_address String?
  created_at     DateTime        @default(now()) @db.Timestamptz(6)
  updated_at     DateTime        @default(now()) @db.Timestamptz(6)
  image_url      String?
  claims         claim[]
  category       category?       @relation(fields: [category_id], references: [id])
  finder         app_user        @relation("listing_finder", fields: [finder_user_id], references: [id])
  photos         listing_photo[]
}

model listing_photo {
  id          String   @id
  listing_id  String
  url         String
  storage_key String?
  sort_order  Int      @default(0)
  uploaded_at DateTime @default(now()) @db.Timestamptz(6)
  listing     listing  @relation(fields: [listing_id], references: [id], onDelete: Cascade)
}

model claim {
  id              String   @id
  listing_id      String
  claimer_user_id String
  status          String   @default("pending")
  message         String?
  created_at      DateTime @default(now()) @db.Timestamptz(6)
  claimer         app_user @relation("claim_user", fields: [claimer_user_id], references: [id])
  listing         listing  @relation(fields: [listing_id], references: [id], onDelete: Cascade)
}

model notification {
  id         String    @id
  user_id    String
  type       String
  channel    String
  payload    Json      @default("{}")
  status     String    @default("queued")
  created_at DateTime  @default(now()) @db.Timestamptz(6)
  sent_at    DateTime?
  user       app_user  @relation("notification_user", fields: [user_id], references: [id], onDelete: Cascade)
}
